{
  "app": {
    "name": "FashionHub",
    "version": "1.0.0",
    "environment": "development",
    "port": 5000,
    "host": "0.0.0.0"
  },
  "frontend": {
    "port": 3000,
    "api_url": "http://localhost:5000",
    "public_url": "http://localhost:3000"
  },
  "database": {
    "type": "postgresql",
    "host": "localhost",
    "port": 5432,
    "name": "fashionhub_db",
    "username": "fashionhub_user",
    "password": "your_local_password",
    "ssl": false,
    "pool": {
      "min": 2,
      "max": 10,
      "idle_timeout": 30000,
      "acquire_timeout": 60000
    }
  },
  "redis": {
    "host": "localhost",
    "port": 6379,
    "password": "your_local_redis_password",
    "db": 0,
    "key_prefix": "fashionhub:"
  },
  "auth": {
    "jwt_secret": "your_local_jwt_secret_key_here",
    "jwt_refresh_secret": "your_local_refresh_jwt_secret_key_here",
    "jwt_expires_in": "24h",
    "jwt_refresh_expires_in": "7d",
    "bcrypt_rounds": 12
  },
  "upload": {
    "max_size": 10485760,
    "allowed_types": ["image/jpeg", "image/png", "image/webp"],
    "storage_path": "./uploads",
    "temp_path": "./tmp"
  },
  "email": {
    "provider": "smtp",
    "host": "smtp.gmail.com",
    "port": 587,
    "secure": true,
    "username": "your_email@gmail.com",
    "password": "your_email_app_password",
    "from_address": "noreply@fashionhub.com",
    "from_name": "FashionHub"
  },
  "payment": {
    "stripe": {
      "secret_key": "sk_test_your_stripe_secret_key",
      "publishable_key": "pk_test_your_stripe_publishable_key",
      "webhook_secret": "whsec_your_stripe_webhook_secret"
    },
    "paypal": {
      "client_id": "your_paypal_client_id",
      "client_secret": "your_paypal_client_secret",
      "mode": "sandbox"
    }
  },
  "security": {
    "cors_origin": ["http://localhost:3000", "http://localhost:5000"],
    "rate_limit": {
      "window_ms": 900000,
      "max_requests": 100
    },
    "helmet": {
      "enabled": true,
      "content_security_policy": true
    }
  },
  "logging": {
    "level": "debug",
    "format": "simple",
    "file": "./logs/app.log",
    "max_size": "10m",
    "max_files": 5
  },
  "monitoring": {
    "health_check_interval": 30000,
    "metrics_enabled": true,
    "prometheus_port": 9090
  },
  "cache": {
    "ttl": 3600,
    "check_period": 600,
    "max_keys": 1000
  },
  "admin": {
    "email": "usamashabir37@gmail.com",
    "default_password": "admin",
    "auto_create": true
  },
  "development": {
    "seed_data": true,
    "debug_mode": true,
    "hot_reload": true
  }
}
