# Database Configuration
DATABASE_URL=postgresql://fashionhub_user:fashionhub_password@localhost:5432/fashionhub_db
REDIS_URL=redis://:redis_password@localhost:6379

# Server Configuration
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_change_in_production_make_it_very_long_and_random_at_least_32_characters
JWT_REFRESH_SECRET=your_refresh_secret_here_change_in_production_make_it_very_long_and_random_at_least_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security Configuration
SESSION_SECRET=your-super-secret-session-key-here-make-it-very-long-and-random
COOKIE_SECRET=your-super-secret-cookie-key-here-make-it-very-long-and-random
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# File Upload Configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/gif
UPLOAD_PATH=./uploads

# Payment Gateway Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
COINBASE_COMMERCE_API_KEY=your_coinbase_commerce_api_key

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@fashionhub.com

# Two-Factor Authentication
TOTP_ISSUER=FashionHub
TOTP_ALGORITHM=SHA1
TOTP_DIGITS=6
TOTP_PERIOD=30

# Logging Configuration
LOG_LEVEL=info
ENABLE_HEALTH_CHECKS=true
ENABLE_METRICS=true

# Redis Configuration
REDIS_PASSWORD=redis_password
REDIS_DB=0

# PostgreSQL Configuration
POSTGRES_DB=fashionhub_db
POSTGRES_USER=fashionhub_user
POSTGRES_PASSWORD=fashionhub_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
